<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Plex, plex.tv, Seerr, Trakt, IPTV sources. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The Dolby Vision 7 -> 8.1 loopback HLS proxy listens on 127.0.0.1. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- IPTV resume points (IPTVResumeStore). Mac App Store archives only
	     (scripts/testflight.sh); local ad-hoc builds use Dusk-macOS.entitlements. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
