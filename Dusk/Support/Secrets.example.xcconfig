// Copy to Dusk/Support/Secrets.xcconfig (git-ignored) and fill in.
// Values from https://trakt.tv/oauth/applications → your Dusk app.
// See docs/trakt.md.

TRAKT_CLIENT_ID = your-trakt-client-id
TRAKT_CLIENT_SECRET = your-trakt-client-secret

// The redirect URI registered on the Trakt app, exactly as entered there.
// Every token refresh sends it (Trakt rejects unregistered ones). Empty =
// refresh with urn:ietf:wg:oauth:2.0:oob, which must then be registered.
//
// - http(s) value (Trakt Development apps accept only localhost): iOS and
//   tvOS sign in with the device code.
// - custom scheme (e.g. dusk://trakt/callback, needs a Production app via
//   Trakt support): iOS/iPadOS sign in through Trakt's page in an in-app
//   browser; tvOS still uses the device code.
//
// `//` starts a comment in an xcconfig, so the `//` after the scheme is
// written `/$()/`. This value is http://localhost
// (the custom-scheme one would be dusk:/$()/trakt/callback):
TRAKT_REDIRECT_URI = http:/$()/localhost
