// Copy to Dusk/Support/Secrets.xcconfig (git-ignored) and fill in.
// Values from https://trakt.tv/oauth/applications → your Dusk app.
// See docs/trakt.md.

TRAKT_CLIENT_ID = your-trakt-client-id
TRAKT_CLIENT_SECRET = your-trakt-client-secret

// Optional, iOS/iPadOS only: the browser sign-in (Trakt's login page in an
// in-app sheet) returns through this redirect. Leave it empty and iOS uses
// the device-code sign-in, like tvOS.
//
// The Trakt app must then list BOTH redirect URIs, one per line:
//   urn:ietf:wg:oauth:2.0:oob
//   dusk://trakt/callback
// Custom schemes need a Production Trakt app (Development apps only accept
// localhost redirects, which iOS cannot catch; ask Trakt support).
//
// `//` starts a comment in an xcconfig, so the `//` after the scheme is
// written `/$()/`. This value is dusk://trakt/callback:
TRAKT_REDIRECT_URI = dusk:/$()/trakt/callback
