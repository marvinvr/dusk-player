// Copy to Dusk/Support/Secrets.xcconfig (git-ignored).
// Use the Client ID from your Trakt Production app. Never add a client secret.
// Register this exact HTTPS URL on your Trakt app. See docs/trakt.md.
TRAKT_CLIENT_ID = your-trakt-client-id
// xcconfig treats // as a comment, so preserve the slashes with /$()/.
TRAKT_REDIRECT_URI = https:/$()/getdusk.app/trakt/callback
