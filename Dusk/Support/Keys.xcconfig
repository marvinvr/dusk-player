// Public-client Trakt settings for both app targets. No client secret.
// Local overrides are git-ignored; release preparation copies only these keys.
TRAKT_CLIENT_ID =
// xcconfig treats // as a comment; /$()/ preserves the HTTPS slashes.
TRAKT_REDIRECT_URI = https:/$()/getdusk.app/trakt/callback

#include? "Secrets.xcconfig"
